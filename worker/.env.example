# ── TWIG worker configuration ────────────────────────────────────────────────
# Copy this file to worker/.env and fill in the values.

# Supabase project credentials (Project Settings → API). The service-role key
# bypasses RLS — it must never leave this worker process.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between worker and frontend (reserved for admin endpoints).
# Use the same value as frontend/WORKER_SHARED_SECRET.
WORKER_SHARED_SECRET=change-me-long-random-string

# Poll interval when no job is pending (seconds).
POLL_INTERVAL_SECONDS=5

# Benchmark probe tuning (optional; defaults shown).
HTTP_TIMEOUT_SECONDS=6
HTTP_SPACING_SECONDS=1
MAX_RUNS_PER_SYSTEM=20
