# ── TWIG frontend configuration ──────────────────────────────────────────────
# Copy this file to frontend/.env.local and fill in the values.
# Without these, the app runs in explicit demo mode (never silent, never broken).

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase project → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Service-role key — SERVER ONLY. Exposes the database if leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── PayPal (Sandbox by default) ──────────────────────────────────────────────
# PayPal developer dashboard → Apps & Credentials → SANDBOX tab → "New App".
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Sandbox (default) or live base URL. Keep sandbox for testing.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id for the "Checkout capture approved" / "PAYMENT.CAPTURE.COMPLETED"
# subscription used to reconcile failed captures (see docs/api.md).
PAYPAL_WEBHOOK_ID=your-webhook-id

# ── Shared worker secret ─────────────────────────────────────────────────────
# Same value as worker/WORKER_SHARED_SECRET. Reserved for admin endpoints.
WORKER_SHARED_SECRET=change-me-long-random-string

# ── AI provider (optional; deterministic fallback otherwise) ────────────────
# Any OpenAI-compatible chat-completions endpoint. When these are missing, the
# agent and spec generator use the deterministic rule-based fallback — the app
# must never depend on an LLM for prices, feasibility, or which datasets exist.
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
